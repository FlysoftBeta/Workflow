{
  "comment": "Engine device acceptance cases (format: engine/runtime/tests/device/README.md). Placeholders: ${LIB} nativeLibraryDir, ${ROOT} filesDir/rootfs, ${FILES}, ${CACHE}, ${RESULTS}, ${ABI}.",
  "defaults": {
    "exe": "${LIB}/libworkflow-engine.so",
    "timeout": 60,
    "cwd": "${FILES}"
  },
  "setup": [
    {"copy": "${LIB}/libwftest-gueststatic.so", "to": "${ROOT}/guest_static", "mode": "755"}
  ],
  "cases": [
    {"id": "probe", "argv": ["probe"], "exit": 0, "stdout": "\"pageSize\":(4096|16384)"},

    {"id": "control-sigsys-bare", "exe": "${LIB}/libwftest-sigsys.so", "argv": [], "exit": [159, 31],
     "note": "control, no engine: the helper's own RET_TRAP filter must kill it with SIGSYS (Java reports 128+31 or 31)"},

    {"id": "pt-sigsys", "argv": ["run", "--", "${LIB}/libwftest-sigsys.so"], "exit": 0, "stdout": "^ok$"},
    {"id": "pt-sigsys-log", "argv": ["run", "--", "${LIB}/libwftest-sigsys.so"], "env": {"WORKFLOW_ENGINE_LOG": "3"},
     "exit": 0, "stderr": "SIGSYS .*statx", "tags": ["self-sigsys"],
     "note": "statx SIGSYS comes from the helper's own filter, not from the app filter"},
    {"id": "pt-forkstress", "argv": ["run", "--", "${LIB}/libwftest-forkstress.so"], "exit": 0},

    {"id": "sysprobe-bare", "exe": "${LIB}/libwftest-sysprobe.so", "argv": [], "exit": 0, "stdout": "^blocked:",
     "tags": ["filter-probe"], "note": "no engine: fork per syscall, child killed by SIGSYS = blocked by the app filter"},
    {"id": "sysprobe-engine", "argv": ["run", "--", "${LIB}/libwftest-sysprobe.so", "--inline"],
     "env": {"WORKFLOW_ENGINE_LOG": "3"}, "exit": 0, "stdoutNot": "BLOCKED", "tags": ["filter-probe", "self-sigsys"],
     "note": "same syscalls in-process under the engine: every blocked one must come back as ENOSYS (SIGSYS lines must equal sysprobe-bare's blocked list)"},

    {"id": "guest-static", "argv": ["run", "--root", "${ROOT}", "--", "/guest_static"], "clearEnv": true,
     "env": {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"},
     "exit": 0, "stdout": "^guest-static-ok$"},
    {"id": "guest-static-nofilemap", "argv": ["run", "--root", "${ROOT}", "--no-filemap", "--", "/guest_static"], "clearEnv": true,
     "env": {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"},
     "exit": 0, "stdout": "^guest-static-ok$"},

    {"id": "guest-true", "argv": ["run", "--root", "${ROOT}", "--", "/bin/true"], "clearEnv": true,
     "env": {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/tmp", "LANG": "C.UTF-8"},
     "exit": 0},
    {"id": "guest-false", "argv": ["run", "--root", "${ROOT}", "--", "/bin/false"], "clearEnv": true,
     "env": {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/tmp", "LANG": "C.UTF-8"},
     "exit": 1},
    {"id": "guest-echo", "argv": ["run", "--root", "${ROOT}", "--", "/bin/echo", "hi"], "clearEnv": true,
     "env": {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/tmp", "LANG": "C.UTF-8"},
     "exit": 0, "stdout": "\\Ahi\\n\\z"},
    {"id": "guest-true-nofilemap", "argv": ["run", "--root", "${ROOT}", "--no-filemap", "--", "/bin/true"], "clearEnv": true,
     "env": {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/tmp", "LANG": "C.UTF-8"},
     "exit": 0},

    {"id": "guest-true-log", "argv": ["run", "--root", "${ROOT}", "--", "/bin/true"], "clearEnv": true,
     "env": {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/tmp", "LANG": "C.UTF-8",
             "WORKFLOW_ENGINE_LOG": "3"},
     "exit": 0, "note": "debug log of the smallest dynamic glibc guest"},
    {"id": "guest-true-nofilemap-log", "argv": ["run", "--root", "${ROOT}", "--no-filemap", "--", "/bin/true"], "clearEnv": true,
     "env": {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/tmp", "LANG": "C.UTF-8",
             "WORKFLOW_ENGINE_LOG": "3"},
     "exit": 0, "note": "debug log of the anonymous-copy loader path"},

    {"id": "guest-bash", "argv": ["run", "--root", "${ROOT}", "--", "/bin/bash", "-c",
       "pwd; cd /usr && pwd; ls /bin/true; cat /etc/debian_version; readlink /proc/self/exe"], "clearEnv": true,
     "env": {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/tmp", "LANG": "C.UTF-8"},
     "exit": 0, "stdout": "\\A/\\n/usr\\n/bin/true\\n13\\.\\d+\\n/usr/bin/readlink\\n\\z",
     "note": "readlink runs as its own process, so /proc/self/exe is /usr/bin/readlink"},
    {"id": "guest-bash-nofilemap", "argv": ["run", "--root", "${ROOT}", "--no-filemap", "--", "/bin/bash", "-c",
       "pwd; cd /usr && pwd; ls /bin/true; cat /etc/debian_version; readlink /proc/self/exe"], "clearEnv": true,
     "env": {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/tmp", "LANG": "C.UTF-8"},
     "exit": 0, "stdout": "\\A/\\n/usr\\n/bin/true\\n13\\.\\d+\\n/usr/bin/readlink\\n\\z"},
    {"id": "guest-bash-log", "argv": ["run", "--root", "${ROOT}", "--", "/bin/bash", "-c",
       "pwd; cd /usr && pwd; ls /bin/true; cat /etc/debian_version; readlink /proc/self/exe"], "clearEnv": true,
     "env": {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/tmp", "LANG": "C.UTF-8",
             "WORKFLOW_ENGINE_LOG": "3"},
     "exit": 0, "note": "debug log kept in out/guest-bash-log.stderr; SIGSYS lines = syscalls the app filter blocks"},
    {"id": "guest-bash-stats", "argv": ["run", "--root", "${ROOT}", "--", "/bin/bash", "-c", "true"], "clearEnv": true,
     "env": {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/tmp", "LANG": "C.UTF-8",
             "WORKFLOW_ENGINE_STATS": "1"},
     "exit": 0, "stderr": "stats syscall_stops=\\d+"},

    {"id": "guest-pipeline", "argv": ["run", "--root", "${ROOT}", "--", "/bin/bash", "-c", "seq 1 2000 | sort -rn | head -1"],
     "clearEnv": true, "env": {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/tmp", "LANG": "C.UTF-8"},
     "exit": 0, "stdout": "\\A2000\\n\\z"},
    {"id": "guest-id", "argv": ["run", "--root", "${ROOT}", "--", "/usr/bin/id", "-u"], "clearEnv": true,
     "env": {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/tmp", "LANG": "C.UTF-8"},
     "exit": 0, "stdout": "\\A1000\\n\\z", "note": "default --user work = uid 1000 (fake identity is M4; informational)"},
    {"id": "guest-exit-code", "argv": ["run", "--root", "${ROOT}", "--", "/bin/sh", "-c", "exit 42"], "clearEnv": true,
     "env": {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/tmp", "LANG": "C.UTF-8"},
     "exit": 42},
    {"id": "survey-bash-log", "argv": ["run", "--root", "${ROOT}", "--", "/bin/bash", "-c",
       "cd /tmp; touch s1; ln -s s1 s2; readlink s2; ls -la s1 s2; stat -c %s s1; cp s1 s3; mv s3 s4; chmod 600 s4; truncate -s 10 s4; ln s4 s5; rm -f s4 s5 s2; mkdir sd; rmdir sd; mkfifo sf; rm -f sf; sort -o s6 /etc/os-release; sha256sum s6; gzip -k s6; ls s6.gz; tar -cf s7.tar s6; tar -tf s7.tar; rm -f s1 s6 s6.gz s7.tar; df -P /; du -s /etc; find /etc -maxdepth 1 -name hostname; test -x /bin/true && echo x-ok; test -w /tmp && echo w-ok; date +%Y; sleep 0.1; timeout 5 true; uname -m; id -un; getent passwd root; seq 3 | sort -rn | head -1; echo x >/dev/null; echo survey-done"],
     "clearEnv": true, "timeout": 90,
     "env": {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/tmp", "LANG": "C.UTF-8",
             "WORKFLOW_ENGINE_LOG": "3"},
     "stdout": "survey-done", "stderrNot": "Function not implemented", "tags": ["sigsys-survey"],
     "note": "independent coreutils/bash operations (a failure does not cascade) under the debug log; its SIGSYS lines are the app-filter survey"},
    {"id": "guest-notfound", "argv": ["run", "--root", "${ROOT}", "--", "no-such-command"], "clearEnv": true,
     "env": {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/tmp", "LANG": "C.UTF-8"},
     "exit": 127}
  ]
}
