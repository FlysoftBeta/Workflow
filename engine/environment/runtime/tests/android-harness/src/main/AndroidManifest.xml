<?xml version="1.0" encoding="utf-8"?>
<!-- No activities: the harness process is started by `am instrument` through zygote like any app process. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- like the real app: guests (apt, git, uv) reach the network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="false"
        android:label="Engine harness" />
</manifest>
