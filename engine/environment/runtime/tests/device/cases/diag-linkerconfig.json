{
 "defaults": {"exe": "${LIB}/libworkflow-engine.so", "timeout": 60, "cwd": "${FILES}"},
 "setup": [],
 "cases": [
  {"id": "diag-lc-host", "exe": "/system/bin/sh", "argv": ["-c", "ls -la /linkerconfig/ld.config.txt; id"], "exit": 0},
  {"id": "diag-lc-guest", "argv": ["run", "--root", "${ROOT}", "--bind", "${LIB}:${LIB}", "--", "${LIB}/libwftest-sysprobe.so", "--help"],
   "clearEnv": true, "env": {"PATH": "/usr/bin:/bin", "WORKFLOW_ENGINE_LOG": "4"}, "note": "trace the bionic linker inside the guest"},
  {"id": "diag-lc-guest-plain", "argv": ["run", "--root", "${ROOT}", "--no-seccomp", "--bind", "${LIB}:${LIB}", "--", "${LIB}/libwftest-sysprobe.so", "--help"],
   "clearEnv": true, "env": {"PATH": "/usr/bin:/bin", "WORKFLOW_ENGINE_LOG": "4"}}
 ]
}
